# Paste your bot token after the = sign (Developer Portal → your app → Bot → Reset Token).
# Never share this or paste it into Discord: it's the bot's password.
DISCORD_TOKEN=

# When the weekly digest posts. Day: 0 = Sunday, 1 = Monday … 6 = Saturday.
# Hour uses a 24h clock in this computer's timezone.
DIGEST_DAY=1
DIGEST_HOUR=9

# Optional: meeting summaries and questions. Leave empty to keep AI off (nothing is spent).
# Create a key at https://console.anthropic.com → API Keys. Each summary and answer uses API credits.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default: claude-opus-5-5).
ANTHROPIC_MODEL=
