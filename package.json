    "token-report": "node scripts/token-report.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "better-sqlite3": "^13.1.1",
    "discord.js": "^14.28.1"
  }
}
