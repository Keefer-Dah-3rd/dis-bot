{
  "name": "mibbit-notes-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot that collects and organizes the Mibbit team's notes.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test test/*.test.js",
