{
  "name": "mibbit-notes-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot that collects and organizes the Mibbit team's notes. Runs on demand on Supabase.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.js",
    "try-meeting": "node --env-file-if-exists=.env scripts/try-meeting.js",
    "post-meeting": "node --env-file-if-exists=.env scripts/post-meeting.js",
    "token-report": "node scripts/token-report.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "supabase": "^3.1.0"
  }
}
